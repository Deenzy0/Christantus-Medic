# ===========================================
# CHRISTANTUS MEDICAL CONSULT - ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to version control.
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/christantus_medical
# OR MongoDB Atlas (cloud), example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/christantus_medical?retryWrites=true&w=majority

# JWT Auth
JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Paystack (Test mode keys from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Switch to your live keys (sk_live_... / pk_live_...) ONLY when going to production

# Frontend URL (for CORS + payment redirect callback)
CLIENT_URL=http://localhost:3000

# Default Admin (created automatically the first time the server starts if no admin exists)
ADMIN_EMAIL=admin@christantusmedical.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Super Admin
